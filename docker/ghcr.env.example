# Copy outside the repository; replace every placeholder before starting.
# Use the same published Git tag or sha-<full commit SHA> for all five images.
SIGNALDECK_BACKEND_IMAGE=ghcr.io/coachpo/signaldeck-backend:replace-with-published-tag
SIGNALDECK_FRONTEND_IMAGE=ghcr.io/coachpo/signaldeck-frontend:replace-with-published-tag
SIGNALDECK_FINANCE_IMAGE=ghcr.io/coachpo/signaldeck-finance:replace-with-published-tag
SIGNALDECK_NOTES_IMAGE=ghcr.io/coachpo/signaldeck-notes:replace-with-published-tag
SIGNALDECK_ORACLE_IMAGE=ghcr.io/coachpo/signaldeck-digital-oracle:replace-with-published-tag
DATABASE_URL='postgresql+psycopg://replace-user:replace-password@postgres.example:5432/replace-core-db'
FINANCE_DATABASE_URL='postgresql+psycopg://replace-finance-user:replace-password@postgres.example:5432/replace-finance-db'
NOTES_DATABASE_URL='postgresql+psycopg://replace-notes-user:replace-password@postgres.example:5432/replace-notes-db'
TEMPORAL_ADDRESS=temporal.example:7233
AGENT_PLATFORM_ENCRYPTION_KEY='replace-with-a-long-random-secret'
SIGNALDECK_API_TOKEN='replace-with-a-different-long-random-secret'
APP_PORT=8089
CORS_ALLOWED_ORIGINS=
