# Copy outside the repository; all passwords must be independent random hex values.
# Generate secrets once and keep this file with the same persistent deployment.
# Pin the application to one release: vX.Y.Z@sha256:<digest> (preferred) or vX.Y.Z, never latest.
SIGNALDECK_IMAGE=ghcr.io/coachpo/signaldeck:replace-with-published-release-tag
# Keep plugins fixed during ordinary application updates.
SIGNALDECK_PLUGIN_TAG=replace-with-published-sha-tag
SIGNALDECK_PLUGIN_IMAGE=ghcr.io/coachpo/signaldeck:${SIGNALDECK_PLUGIN_TAG}
POSTGRES_PASSWORD=replace-bootstrap-password
CORE_DB_PASSWORD=replace-core-password
FINANCE_DB_PASSWORD=replace-finance-password
NOTES_DB_PASSWORD=replace-notes-password
TEMPORAL_DB_PASSWORD=replace-temporal-password
AGENT_PLATFORM_ENCRYPTION_KEY=replace-encryption-key
DATABASE_URL=postgresql+psycopg://signaldeck_core:${CORE_DB_PASSWORD}@db:5432/signaldeck_core
FINANCE_DATABASE_URL=postgresql+psycopg://signaldeck_finance:${FINANCE_DB_PASSWORD}@db:5432/signaldeck_finance
NOTES_DATABASE_URL=postgresql+psycopg://signaldeck_notes:${NOTES_DB_PASSWORD}@db:5432/signaldeck_notes
TEMPORAL_ADDRESS=temporal:7233
APP_PORT=8089
CORS_ALLOWED_ORIGINS=
COMPOSE_PROFILES=finance,notes,digital-oracle
SIGNALDECK_PLUGINS=finance,notes,digital-oracle
# Optional provider settings; uncomment and fill in only in the private copy.
# SEC EDGAR contact email, passed to Finance and Oracle.
# EDGAR_CONTACT_EMAIL=
# FRED API key, passed to Oracle only.
# FRED_API_KEY=
